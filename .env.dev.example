# Local development environment — copy to .env.dev and edit
# docker compose --env-file .env.dev up --build

# Postgres password (any string is fine for local dev)
POSTGRES_PASSWORD=openserve_dev

# JWT signing secret — any 32+ byte random string
JWT_SECRET=local-dev-secret-change-in-production-32bytes

# Email to authenticate as in dev mode (bypasses Google OIDC)
DEV_EMAIL=dev@localhost

# Leave blank in dev mode (DEV_EMAIL takes precedence)
GOOGLE_CLIENT_ID=
